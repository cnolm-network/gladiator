# ---- Java / Gradle ----
.gradle/
build/
out/
*.class
*.jar
# wrapper 必须入库，否则新机器无法执行 ./gradlew；否定规则要放在 *.jar 之后才生效
!gradle/wrapper/gradle-wrapper.jar
# libs/*.jar 是本地构建的编译期依赖（如 golem-api），不入库；占位文件保留目录
libs/*.jar
!libs/.gitkeep

# ---- IDE ----
# 其余 .idea 配置是本机状态，不入库；只共享 Gradle 运行配置（IDE 可直接点 Run）
.idea/*
!.idea/runConfigurations/
*.iml
*.ipr
*.iws
.vs/
.vscode/

# ---- Node.js (Layer 2) ----
node_modules/
bot-runtime/logs/
npm-debug.log*

# ---- Python (Layer 3) ----
training/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

training/artifacts/

# ---- 运行时产物 ----
run/
*.log
logs/
codex.toml

# ---- 平台侧记忆（WorkBuddy 自管，不入库）----
.workbuddy/memory/

# ---- 本地私有配置 ----
*.local.json
.env
.env.*

# ---- 本地开发服务端（体积大，不入库）----
server/*.jar
server/world/
server/world_nether/
server/world_the_end/
server/logs/
server/plugins/
server/cache/
server/eula.txt
server/banned-ips.json
server/banned-players.json
server/ops.json
server/usercache.json
server/whitelist.json
server/bukkit.yml
server/commands.yml
server/help.yml
server/paper.yml
server/spigot.yml
server/permissions.yml
# 只随仓库发布三只内置模型，其余 .gmod 是本机自测产物
models/*.gmod
!models/default.gmod
!models/release.gmod
!models/flash.gmod
